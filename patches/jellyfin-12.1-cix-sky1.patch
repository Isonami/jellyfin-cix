+        /// <summary>
+        /// Gets the parameter of the CIX Sky1 V4L2M2M/OpenCL filter chain.
+        /// V4L2M2M decode and encode surfaces are system-memory frames, while
+        /// scaling and HDR tone mapping are performed on the Mali OpenCL device.
+        /// </summary>
+        /// <param name="state">Encoding state.</param>
+        /// <param name="options">Encoding options.</param>
+        /// <param name="vidEncoder">Video encoder to use.</param>
+        /// <returns>The tuple contains three lists: main, sub and overlay filters.</returns>
+        public (List<string> MainFilters, List<string> SubFilters, List<string> OverlayFilters) GetCixVidFilterChain(
+            EncodingJobInfo state,
+            EncodingOptions options,
+            string vidEncoder)
+        {
+            if (options.HardwareAccelerationType != HardwareAccelerationType.cix
+                || !OperatingSystem.IsLinux()
+                || !IsOpenclFullSupported())
+            {
+                return GetSwVidFilterChain(state, options, vidEncoder);
+            }
+
+            var inW = state.VideoStream?.Width;
+            var inH = state.VideoStream?.Height;
+            var reqW = state.BaseRequest.Width;
+            var reqH = state.BaseRequest.Height;
+            var reqMaxW = state.BaseRequest.MaxWidth;
+            var reqMaxH = state.BaseRequest.MaxHeight;
+
+            var doDeintH2645 = IsDeinterlaceAvailable(state);
+            var doOclTonemap = IsHwTonemapAvailable(state, options);
+            var hasSubs = state.SubtitleStream is not null && ShouldEncodeSubtitle(state);
+            var hasTextSubs = hasSubs && state.SubtitleStream.IsTextSubtitleStream;
+            var hasGraphicalSubs = hasSubs && !state.SubtitleStream.IsTextSubtitleStream;
+
+            var rotation = state.VideoStream?.Rotation ?? 0;
+            var transposeDir = rotation == 0 ? string.Empty : GetVideoTransposeDirection(state);
+            var doOclTranspose = !string.IsNullOrEmpty(transposeDir)
+                && _mediaEncoder.SupportsFilterWithOption(FilterOptionType.TransposeOpenclReversal);
+            if (rotation != 0 && !doOclTranspose)
+            {
+                return GetSwVidFilterChain(state, options, vidEncoder);
+            }
+
+            var swapWAndH = Math.Abs(rotation) == 90;
+            var swpInW = swapWAndH ? inH : inW;
+            var swpInH = swapWAndH ? inW : inH;
+            var mainFilters = new List<string>
+            {
+                GetOverwriteColorPropertiesParam(state, doOclTonemap)
+            };
+
+            // CIX V4L2M2M returns system-memory frames, so deinterlace before upload.
+            if (doDeintH2645)
+            {
+                mainFilters.Add(GetSwDeinterlaceFilter(state, options));
+            }
+
+            // Sky1 V4L2M2M exposes decoded frames as NV12 even for 10-bit sources.
+            // Keep the system-memory input as NV12 and let scale_opencl perform the
+            // NV12-to-P010 conversion on the GPU when tonemap_opencl needs it.
+            mainFilters.Add("format=nv12");
+            mainFilters.Add("hwupload=derive_device=opencl");
+
+            if (doOclTranspose)
+            {
+                mainFilters.Add($"transpose_opencl=dir={transposeDir}");
+            }
+
+            var scaleOutputFormat = doOclTonemap ? "p010le" : "nv12";
+            var hwScaleFilter = GetHwScaleFilter(
+                "scale",
+                "opencl",
+                scaleOutputFormat,
+                false,
+                swpInW,
+                swpInH,
+                reqW,
+                reqH,
+                reqMaxW,
+                reqMaxH);
+            if (!string.IsNullOrEmpty(hwScaleFilter))
+            {
+                mainFilters.Add(hwScaleFilter + ":algo=bicubic");
+            }
+
+            // Scale first so the GPU both converts NV12 to P010 and reduces the
+            // number of pixels processed by tone mapping.
+            if (doOclTonemap)
+            {
+                mainFilters.Add(GetHwTonemapFilter(options, "opencl", "nv12", false));
+            }
+
+            mainFilters.Add("hwdownload");
+            mainFilters.Add("format=nv12");
+
+            if (hasTextSubs)
+            {
+                mainFilters.Add(GetTextSubtitlesFilter(state, false, false));
+            }
+
+            var subFilters = new List<string>();
+            var overlayFilters = new List<string>();
+            if (hasGraphicalSubs)
+            {
+                var subW = state.SubtitleStream?.Width;
+                var subH = state.SubtitleStream?.Height;
+                subFilters.Add(GetGraphicalSubPreProcessFilters(
+                    swpInW,
+                    swpInH,
+                    subW,
+                    subH,
+                    reqW,
+                    reqH,
+                    reqMaxW,
+                    reqMaxH));
+                overlayFilters.Add("overlay=eof_action=pass:repeatlast=0");
+            }
+
+            return (mainFilters, subFilters, overlayFilters);
+        }
