+        /// <summary>
+        /// Gets an explicit CIX Sky1 V4L2M2M decoder argument.
+        /// </summary>
+        /// <param name="options">Encoding options.</param>
+        /// <param name="videoStream">Input video stream.</param>
+        /// <param name="bitDepth">Input video bit depth.</param>
+        /// <returns>The decoder argument, or <see langword="null"/> when unsupported.</returns>
+        public string GetCixVidDecoder(EncodingOptions options, MediaStream videoStream, int bitDepth)
+        {
+            if (!OperatingSystem.IsLinux()
+                || options.HardwareAccelerationType != HardwareAccelerationType.cix)
+            {
+                return null;
+            }
+
+            var is8BitFormat = string.Equals("yuv420p", videoStream.PixelFormat, StringComparison.OrdinalIgnoreCase)
+                               || string.Equals("yuvj420p", videoStream.PixelFormat, StringComparison.OrdinalIgnoreCase);
+            var is10BitFormat = string.Equals("yuv420p10le", videoStream.PixelFormat, StringComparison.OrdinalIgnoreCase);
+            if (!is8BitFormat && !is10BitFormat)
+            {
+                return null;
+            }
+
+            var codec = videoStream.Codec?.ToLowerInvariant();
+            var decoderPrefix = codec switch
+            {
+                "avc" => "h264",
+                "h264" => "h264",
+                "h265" => "hevc",
+                "hevc" => "hevc",
+                "mpeg1video" => "mpeg1",
+                "mpeg2video" => "mpeg2",
+                "mpeg4" => "mpeg4",
+                "vc1" => "vc1",
+                "vp8" => "vp8",
+                "vp9" => "vp9",
+                "av1" => "av1",
+                _ => null
+            };
+            var configuredCodec = codec switch
+            {
+                "avc" => "h264",
+                "h265" => "hevc",
+                _ => codec
+            };
+
+            return decoderPrefix is null
+                ? null
+                : GetHwDecoderName(options, decoderPrefix, "v4l2m2m", configuredCodec, bitDepth);
+        }
